# Chỉ là giá trị minh họa cho local; không dùng lại ở production.
# Biến dành cho PostgreSQL local. Compose dùng các giá trị mặc định này.
POSTGRES_DB=pharmacy_study
POSTGRES_USER=pharmacy_dev
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pharmacy_dev:local-dev-only@127.0.0.1:5432/pharmacy_study
NEXT_TELEMETRY_DISABLED=1
# Chỉ bật user dev cho next dev; production sẽ từ chối AUTH_MODE=dev.
AUTH_MODE=dev
# Không đặt DATABASE_URL hoặc secret trong NEXT_PUBLIC_*.

# P03: chạy db:migrate rồi db:provision -- --write-local-env trước khi bật oidc.
# Provision thay DATABASE_URL bằng login app ít quyền, lưu maintenance ở .env.db.
# Google: chuyển AUTH_MODE=oidc và điền riêng các giá trị sau (xem runbook).
# PORT=3001
# NEXTAUTH_URL=http://localhost:3001
# APP_ORIGIN=http://localhost:3001
# NEXTAUTH_SECRET=<generate-private-random-value-at-least-32-characters>
# GOOGLE_CLIENT_ID=<your-web-oauth-client-id>
# GOOGLE_CLIENT_SECRET=<your-private-client-secret>
# ADMIN_EMAILS=<your-google-email>
# INVITED_EMAILS=<comma-separated-invited-google-emails>
# Không dùng provider test trong production; không commit cấu hình thật.
