# Chỉ là giá trị minh họa cho local; không dùng lại ở production.
# Biến dành cho PostgreSQL local. Compose dùng các giá trị mặc định này.
POSTGRES_DB=pharmacy_study
POSTGRES_USER=pharmacy_dev
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pharmacy_dev:local-dev-only@127.0.0.1:5432/pharmacy_study
NEXT_TELEMETRY_DISABLED=1
# P00 chưa dùng database trong app; không đặt secret trong biến NEXT_PUBLIC_*.
