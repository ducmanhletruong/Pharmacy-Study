{
  "name": "pharmacy-study",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pharmacy/web dev",
    "start": "pnpm --filter @pharmacy/web start",
    "build": "pnpm --filter @pharmacy/web build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && pnpm --filter @pharmacy/web typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
